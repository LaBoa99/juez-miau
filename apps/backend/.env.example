# ===================================
# SERVIDOR & APLICACIÓN
# ===================================
PORT=3000
NODE_ENV=development
# Orígenes permitidos separados por coma. No puede ser "*" porque el refresh token viaja en cookie
CORS_ORIGIN=http://localhost:4200
# Cookie de refresh solo por HTTPS. Sin definir: true si NODE_ENV=production. Usa false si se sirve por HTTP
# COOKIE_SECURE=false

# ===================================
# BASE DE DATOS (PostgreSQL / TypeORM)
# ===================================
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=concurso_db
DB_SYNCHRONIZE=true

# ===================================
# REDIS (BullMQ - Colas de Trabajo)
# ===================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ===================================
# WORKER DE EVALUACIÓN
# ===================================
# Arranca con: pnpm start:worker:dev (necesita Docker y las imágenes de los lenguajes)
# Ejecuciones en paralelo: una por núcleo físico reservado para juzgar
WORKER_CONCURRENCY=1

# CPUs lógicas para juzgar, una por núcleo físico (lscpu -e), p. ej. 2,3,4.
# Vacío = las últimas WORKER_CONCURRENCY CPUs
JUDGE_CPUS=

# Carpeta del host para el código y los casos de cada ejecución. Debe ser la misma ruta en el
# host y en el worker: los contenedores los crea el Docker del host
DOCKER_TMP_DIR=/tmp/concurso-submissions

# ===================================
# MULTIPLICADORES DE TIEMPO POR LENGUAJE
# ===================================
# Ajuste para compensar la inicialización de Máquinas Virtuales/Intérpretes
TIMEOUT_MULT_C=1.0
TIMEOUT_MULT_CPP=1.0
TIMEOUT_MULT_TS=1.5
TIMEOUT_MULT_PYTHON=2.0
TIMEOUT_MULT_JAVA=2.5

# ===================================
# SEGURIDAD DE EQUIPOS
# ===================================
# Llave maestra y salt para derivar (scrypt) la clave de cifrado de contraseñas de equipos.
# Si cambian, las contraseñas ya guardadas dejan de poder descifrarse
PASSWORD_ADMIN_MASTERKEY=cambia_esto_por_una_llave_larga_y_aleatoria
TEAM_SALT=cambia_esto_por_un_salt_aleatorio
# Rondas de bcrypt (por defecto 10)
SALT_ROUNDS=10

# ===================================
# SEEDER
# ===================================
# Superadmin que crea el seeder "base" (solo si no existe). En prod usa una contraseña fuerte
SEED_ADMIN_EMAIL=admin@concurso.local
SEED_ADMIN_PASSWORD=admin12345

# ===================================
# FRONTEND
# ===================================
# URL base del frontend (se usa para armar la URL del proyector)
FRONT_END_URL=http://localhost:4200

# =============================================
# AUTENTICACIÓN (JWT)
# =============================================
JWT_SECRET=cambia_esto_por_un_secreto_largo_y_aleatorio
JWT_ACCESS_EXPIRES_IN=15m
# Token de equipo: dura todo el concurso; se invalida al cerrar o reemplazar la sesión
JWT_TEAM_EXPIRES_IN=12h
REFRESH_TOKEN_TTL_DAYS=7
