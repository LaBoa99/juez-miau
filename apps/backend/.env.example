# ===================================
# SERVIDOR & APLICACIÓN
# ===================================
PORT=3000
NODE_ENV=development
# Orígenes permitidos separados por coma. No puede ser "*" porque el refresh token viaja en cookie
CORS_ORIGIN=http://localhost:4200

# ===================================
# BASE DE DATOS (PostgreSQL / TypeORM)
# ===================================
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=concurso_db
DB_SYNCHRONIZE=true

# ===================================
# REDIS (BullMQ - Colas de Trabajo)
# ===================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ===================================
# WORKER DE EVALUACIÓN
# ===================================
# Número de ejecuciones en paralelo (Igual al número de Cores de CPU)
WORKER_CONCURRENCY=4

# Carpeta del Host para escribir archivos temporales antes de pasarlos a Docker
DOCKER_TMP_DIR=/tmp/concurso-submissions

# ===================================
# MULTIPLICADORES DE TIEMPO POR LENGUAJE
# ===================================
# Ajuste para compensar la inicialización de Máquinas Virtuales/Intérpretes
TIMEOUT_MULT_C=1.0
TIMEOUT_MULT_CPP=1.0
TIMEOUT_MULT_TS=1.5
TIMEOUT_MULT_PYTHON=2.0
TIMEOUT_MULT_JAVA=2.5


# ===================================
# FRONTEND
# ===================================
# URL base del frontend (se usa para armar la URL del proyector)
FRONT_END_URL=http://localhost:4200

# =============================================
# AUTENTICACIÓN (JWT)
# =============================================
JWT_SECRET=cambia_esto_por_un_secreto_largo_y_aleatorio
JWT_ACCESS_EXPIRES_IN=15m
REFRESH_TOKEN_TTL_DAYS=7
