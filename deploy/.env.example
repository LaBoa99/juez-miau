# Copiar a deploy/.env y cambiar TODO lo marcado con "cambia_esto".
# Generar secretos con: openssl rand -hex 32

# ===================================
# ACCESO
# ===================================
# Cómo entran los usuarios. En el laboratorio suele ser la IP de esta máquina
PUBLIC_URL=http://192.168.1.50
# :80 = HTTP por IP. Con un dominio (concurso.midominio.mx) Caddy activa HTTPS solo
SITE_ADDRESS=:80
HTTP_PORT=80
HTTPS_PORT=443
# false mientras se sirva por HTTP; true con HTTPS. Si queda en true sobre HTTP,
# el navegador descarta la cookie de refresh y el staff pierde la sesión al recargar
COOKIE_SECURE=false

# ===================================
# BASE DE DATOS
# ===================================
DB_USERNAME=concurso
DB_PASSWORD=cambia_esto
DB_DATABASE=concurso_db
# false en producción: el esquema cambia solo con migraciones (la API las aplica al arrancar).
# true deja que TypeORM ajuste el esquema solo y puede borrar columnas con datos
DB_SYNCHRONIZE=false

# ===================================
# REDIS
# ===================================
REDIS_PASSWORD=cambia_esto

# ===================================
# SEGURIDAD
# ===================================
JWT_SECRET=cambia_esto
JWT_ACCESS_EXPIRES_IN=15m
REFRESH_TOKEN_TTL_DAYS=7
# Si cambian, las contraseñas de equipos ya guardadas dejan de poder descifrarse:
# deben ser las mismas en todas las máquinas donde se restaure un respaldo
PASSWORD_ADMIN_MASTERKEY=cambia_esto
TEAM_SALT=cambia_esto
SALT_ROUNDS=10

# ===================================
# SEEDER (corre en cada arranque de la API; es idempotente)
# ===================================
# base | prod | dev | none. Nunca "dev" en el concurso: crea usuarios con contraseña conocida
SEED_PROFILE=prod
SEED_ADMIN_EMAIL=admin@concurso.local
SEED_ADMIN_PASSWORD=cambia_esto

# ===================================
# JUEZ (servicio worker)
# ===================================
# 1 = cola en serie (recomendado, ver docs/design/server-specs.md)
WORKER_CONCURRENCY=1
# CPUs lógicas para juzgar, una por núcleo físico (lscpu -e), p. ej. 2,3. Vacío = las últimas
# WORKER_CONCURRENCY. Deja libres las de la API, Postgres y Redis
JUDGE_CPUS=
# Carpeta del HOST donde el worker escribe el código de cada envío. El worker la crea al arrancar
SUBMISSIONS_DIR=/var/lib/concurso/submissions

# ===================================
# IMÁGENES DEL JUEZ (opcional: estos son los valores por defecto)
# ===================================
# "docker compose up" las descarga antes de arrancar el worker, y el seeder actualiza los
# lenguajes base para usarlas. Si cambias la versión mayor (p. ej. python:3.13-slim), cambia
# también compiler_version en apps/backend/src/database/seeds/base/language.seeder.ts.
# Un lenguaje creado desde el panel con otra imagen no se descarga solo: agrégalo aquí y al compose.
# JUDGE_IMAGE_GCC=gcc:14
# JUDGE_IMAGE_DOTNET=mcr.microsoft.com/dotnet/sdk:8.0
# JUDGE_IMAGE_JAVA=eclipse-temurin:21-jdk
# JUDGE_IMAGE_NODE=node:24-slim
# JUDGE_IMAGE_PYTHON=python:3.12-slim

# Puertos de Postgres y Redis en 127.0.0.1 (solo para desarrollo local; no se ven desde la red)
# DB_LOCAL_PORT=5432
# REDIS_LOCAL_PORT=6379

# ===================================
# OTROS
# ===================================
TZ=America/Mexico_City
# Etiqueta de las imágenes construidas (p. ej. 2026-2 para el semestre)
IMAGE_TAG=latest

# ===================================
# TELEMETRÍA (opcional)
# ===================================
# Credenciales de https://observe.nestjs.com. Vacías = sin telemetría
OBSERVE_APP_KEY=
OBSERVE_APP_SECRET=
