# Configuración de esta instalación. deploy/instalar.sh lo llena solo; a mano: cp .env.example .env
# y cambia lo marcado con "cambia_esto" (genera cada secreto con: openssl rand -hex 32).
# Guárdalo junto con los respaldos: sin PASSWORD_ADMIN_MASTERKEY y TEAM_SALT no se restauran.

# ===================================
# ACCESO
# ===================================
# Dirección con la que se entra al panel. En el laboratorio, la IP de esta máquina
PUBLIC_URL=http://192.168.1.50
# false mientras se sirva por HTTP. Si queda en true sobre HTTP, el staff pierde la sesión al recargar
COOKIE_SECURE=false

# ===================================
# SECRETOS
# ===================================
DB_PASSWORD=cambia_esto
JWT_SECRET=cambia_esto
# Cifran las contraseñas de los equipos: deben ser los mismos donde se restaure un respaldo
PASSWORD_ADMIN_MASTERKEY=cambia_esto
TEAM_SALT=cambia_esto

# Primer superadmin. Solo se usa al crearlo: después la contraseña se cambia desde el panel
SEED_ADMIN_EMAIL=admin@concurso.local
SEED_ADMIN_PASSWORD=cambia_esto

# ===================================
# OPCIONAL (estos son los valores por defecto)
# ===================================
# Con un dominio (concurso.midominio.mx) Caddy activa HTTPS solo; entonces COOKIE_SECURE=true
# SITE_ADDRESS=:80
# HTTP_PORT=80
# HTTPS_PORT=443

# CPUs lógicas para juzgar, una por núcleo físico (lscpu -e), p. ej. 2,3, y cuántos envíos a la
# vez (la misma cantidad). Vacío = la última CPU y uno a la vez
# JUDGE_CPUS=
# WORKER_CONCURRENCY=1

# Versión de las imágenes (latest o el commit, para volver a una anterior)
# IMAGE_TAG=latest

# base | prod | dev | none. Nunca "dev" en el concurso: crea usuarios con contraseña conocida
# SEED_PROFILE=prod

# Imágenes del juez. Si cambias la versión mayor, cambia también compiler_version del lenguaje
# JUDGE_IMAGE_GCC=gcc:14
# JUDGE_IMAGE_DOTNET=mcr.microsoft.com/dotnet/sdk:8.0
# JUDGE_IMAGE_JAVA=eclipse-temurin:21-jdk
# JUDGE_IMAGE_NODE=node:24-slim
# JUDGE_IMAGE_PYTHON=python:3.12-slim

# Sesiones
# JWT_ACCESS_EXPIRES_IN=15m
# JWT_TEAM_EXPIRES_IN=12h
# REFRESH_TOKEN_TTL_DAYS=7

# Telemetría de https://observe.nestjs.com. Vacías = sin telemetría
# OBSERVE_APP_KEY=
# OBSERVE_APP_SECRET=
