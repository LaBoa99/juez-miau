# Copiar a deploy/.env y cambiar TODO lo marcado con "cambia_esto".
# Generar secretos con: openssl rand -hex 32

# ===================================
# ACCESO
# ===================================
# Cómo entran los usuarios. En el laboratorio suele ser la IP de esta máquina
PUBLIC_URL=http://192.168.1.50
# :80 = HTTP por IP. Con un dominio (concurso.midominio.mx) Caddy activa HTTPS solo
SITE_ADDRESS=:80
HTTP_PORT=80
HTTPS_PORT=443
# false mientras se sirva por HTTP; true con HTTPS. Si queda en true sobre HTTP,
# el navegador descarta la cookie de refresh y el staff pierde la sesión al recargar
COOKIE_SECURE=false

# ===================================
# BASE DE DATOS
# ===================================
DB_USERNAME=concurso
DB_PASSWORD=cambia_esto
DB_DATABASE=concurso_db
# TEMPORAL: aún no hay migraciones de TypeORM. Con true el esquema se ajusta solo al arrancar,
# lo que puede borrar columnas con datos al actualizar el código. Respaldar antes de actualizar
# (scripts/backup.sh) y pasar a migraciones antes de guardar ediciones reales
DB_SYNCHRONIZE=true

# ===================================
# REDIS
# ===================================
REDIS_PASSWORD=cambia_esto

# ===================================
# SEGURIDAD
# ===================================
JWT_SECRET=cambia_esto
JWT_ACCESS_EXPIRES_IN=15m
REFRESH_TOKEN_TTL_DAYS=7
# Si cambian, las contraseñas de equipos ya guardadas dejan de poder descifrarse:
# deben ser las mismas en todas las máquinas donde se restaure un respaldo
PASSWORD_ADMIN_MASTERKEY=cambia_esto
TEAM_SALT=cambia_esto
SALT_ROUNDS=10

# ===================================
# SEEDER (corre en cada arranque de la API; es idempotente)
# ===================================
# base | prod | dev | none. Nunca "dev" en el concurso: crea usuarios con contraseña conocida
SEED_PROFILE=prod
SEED_ADMIN_EMAIL=admin@concurso.local
SEED_ADMIN_PASSWORD=cambia_esto

# ===================================
# JUEZ (servicio worker)
# ===================================
# Vacío = sin juez. "judge" cuando exista src/worker.ts
COMPOSE_PROFILES=
# 1 = cola en serie (recomendado, ver docs/design/server-specs.md)
WORKER_CONCURRENCY=1
# Carpeta del HOST donde el worker escribe el código de cada envío. Debe existir
SUBMISSIONS_DIR=/var/lib/concurso/submissions
# GID del grupo docker del host: getent group docker | cut -d: -f3
DOCKER_GID=999

# ===================================
# OTROS
# ===================================
TZ=America/Mexico_City
# Etiqueta de las imágenes construidas (p. ej. 2026-2 para el semestre)
IMAGE_TAG=latest
